# ===== App =====
APP_NAME=Misr Assistant API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false

# ===== API =====
API_V1_PREFIX=/api/v1

# ===== Database =====
# Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./misr_assistant.db

# Production (PostgreSQL) - uncomment for prod
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ===== Auth =====
SECRET_KEY=change-this-to-a-strong-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== Google Gemini API =====
# Get your free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=PUT_YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# ===== CORS (production) =====
# Add your Vercel domain here
# CORS_ORIGINS=["https://misr-assistant.vercel.app","https://misr-assistant.com"]